CHERRYFLOW_API_PORT=4000
CHERRYFLOW_API_HOST=127.0.0.1
CHERRYFLOW_WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_CHERRYFLOW_API_URL=http://localhost:4000
CHERRYFLOW_DATA_FILE=./data/cherryflow.json
CHERRYFLOW_MAX_BODY_MB=8

# json | postgres
CHERRYFLOW_STORE=json
# true: apply pending PostgreSQL migrations before the API starts.
# false: fail startup when migrations are pending; run pnpm db:migrate during deploy.
CHERRYFLOW_AUTO_MIGRATE=true

# in_process | redis
CHERRYFLOW_RUNNER=in_process

CHERRYFLOW_ADMIN_USER=cherryflow-admin
CHERRYFLOW_ADMIN_PASSWORD=change-me
CHERRYFLOW_SESSION_DAYS=7
ML_WORKER_CONCURRENCY=1

# local | openai | openclaw
CHERRYFLOW_AI_PROVIDER=local

# OpenAI-compatible provider such as vLLM, SGLang, or Ollama proxy
OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_API_KEY=
OPENAI_MODEL=qwen3.5-35b-a3b
OPENAI_RESPONSE_FORMAT=json_object
OPENAI_REASONING_EFFORT=
OPENAI_MAX_TOKENS=

# AI memory embeddings: local uses the zero-config deterministic fallback.
CHERRYFLOW_EMBEDDING_PROVIDER=local
EMBEDDING_BASE_URL=http://localhost:8000/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3-embedding

# Qwen -> PDF skill flow node.
CHERRYFLOW_REPORT_PDF_SKILL=auto
# CHERRYFLOW_REPORT_PDF_SKILL_PATH=/absolute/path/to/skill_pdf/run_report.py
CHERRYFLOW_REPORT_PDF_TIMEOUT_MS=180000
PYTHON_BIN=python3

# Optional OpenClaw HTTP bridge adapter
OPENCLAW_BRIDGE_URL=http://localhost:18790
OPENCLAW_API_TOKEN=change-me
OPENCLAW_AGENT_ID=cherryflow-ui-builder

# Notification connectors. Credentials remain server-side. Dry Run is the safe default.
CHERRYFLOW_NOTIFICATION_DRY_RUN=true
CHERRYFLOW_NOTIFICATION_TIMEOUT_MS=15000
CHERRYFLOW_ALLOW_CUSTOM_CONNECTOR_ENDPOINTS=false

# Telegram Bot API
# TELEGRAM_BOT_TOKEN=123456789:replace-with-bot-token
# TELEGRAM_CHAT_ID=-1001234567890
# TELEGRAM_API_BASE_URL=https://api.telegram.org

# Discord incoming webhook
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN
# DISCORD_USERNAME=CherryFlow Ops

# LINE Messaging API
# LINE_CHANNEL_ACCESS_TOKEN=replace-with-channel-access-token
# LINE_TO=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LINE_API_BASE_URL=https://api.line.me

# Crypto exchange adapter.
# Install once in this workspace before using exchange workflows:
# pnpm --filter @cherryflow/api add ccxt@^4.5.67
CHERRYFLOW_CRYPTO_CCXT_PACKAGE=ccxt
CHERRYFLOW_CRYPTO_TIMEOUT_MS=15000

# Safe defaults. Private reads are allowed, account-changing operations are disabled.
CHERRYFLOW_CRYPTO_PRIVATE_READS=true
CHERRYFLOW_CRYPTO_LIVE_TRADING=false
CHERRYFLOW_CRYPTO_REQUIRE_SANDBOX=true
CHERRYFLOW_CRYPTO_ALLOW_LEVERAGE=false
CHERRYFLOW_CRYPTO_MAX_ORDER_NOTIONAL=1000
CHERRYFLOW_CRYPTO_MAX_LEVERAGE=3

# Optional comma-separated allowlists. Empty means all CCXT-supported exchanges/symbols.
# CHERRYFLOW_CRYPTO_ALLOWED_EXCHANGES=binance,okx,bybit,bitget,kraken,coinbase
# CHERRYFLOW_CRYPTO_ALLOWED_SYMBOLS=BTC/USDT,ETH/USDT,BTC/USDT:USDT,ETH/USDT:USDT

# Credential profile convention. Keep withdrawal permission disabled on every API key.
# Profile name is selected by credentialProfile in the workflow; default is exchangeId.
# CHERRYFLOW_CRYPTO_PROFILE_BINANCE_API_KEY=replace-with-api-key
# CHERRYFLOW_CRYPTO_PROFILE_BINANCE_SECRET=replace-with-api-secret
# CHERRYFLOW_CRYPTO_PROFILE_BINANCE_PASSWORD=
# CHERRYFLOW_CRYPTO_PROFILE_BINANCE_UID=
# CHERRYFLOW_CRYPTO_PROFILE_BINANCE_WALLET_ADDRESS=
# CHERRYFLOW_CRYPTO_PROFILE_BINANCE_PRIVATE_KEY=

# Example second profile for the same or another exchange.
# CHERRYFLOW_CRYPTO_PROFILE_OKX_API_KEY=replace-with-api-key
# CHERRYFLOW_CRYPTO_PROFILE_OKX_SECRET=replace-with-api-secret
# CHERRYFLOW_CRYPTO_PROFILE_OKX_PASSWORD=replace-with-passphrase

# Optional production backends.
# DATABASE_URL=postgresql://cherryflow:cherryflow@127.0.0.1:5432/cherryflow
# REDIS_URL=redis://127.0.0.1:6379

# Optional MinIO/S3 object storage.
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=cherryflow
# S3_ACCESS_KEY_ID=cherryflow
# S3_SECRET_ACCESS_KEY=change-me
# S3_FORCE_PATH_STYLE=true
